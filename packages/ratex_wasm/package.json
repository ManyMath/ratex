  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./ratex_ffi.wasm": "./ratex_ffi.wasm"
  },
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "ratex_ffi.wasm"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bash ../../tool/build_wasm.sh",
    "test": "node --test test/*.test.js"
  }
